{
  "name": "qw-pages-dynamic-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --configLoader runner && node scripts/prepare-publish.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node scripts/local-workbench.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/runtime.test.mjs",
    "test:driver": "node --test tests/local-source.test.mjs",
    "test:ui": "node scripts/source-ui-battery.mjs",
    "test:value": "node scripts/source-value-audit.mjs",
    "start:local": "node scripts/local-workbench.mjs",
    "test:local-workbench": "node --test tests/local-source.test.mjs tests/docs.test.mjs",
    "test:hosted": "node scripts/verify-local.mjs && node scripts/r37-four-feats-battery.cjs && node scripts/r35-agent1-battery.cjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "electron-to-chromium": "1.5.395"
  }
}